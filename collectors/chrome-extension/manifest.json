{
  "manifest_version": 3,
  "name": "EvoWork Browser Tracker",
  "version": "1.0.0",
  "description": "Track browser activity and send to EvoWork AI for work pattern analysis",
  "permissions": ["tabs", "activeTab", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
